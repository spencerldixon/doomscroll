SECRET_KEY_BASE=

# Required in production. Generate with `bin/rails db:encryption:init`.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Host every generated link points at (zine emails, Telegram notifications).
# Leave blank in development to use localhost:3000.
APP_HOST=
MAILER_DEFAULT_URL_PORT=
MAILER_DEFAULT_FROM=

SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional default/fallback Telegram bot for zine delivery. A reader can set
# their own bot token and chat id instead, in onboarding or preferences.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
