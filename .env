SECRET_KEY_BASE=
DB_PASSWORD=

# Required in production. Generate with `bin/rails db:encryption:init`.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

MAILER_DEFAULT_URL_HOST=localhost
MAILER_DEFAULT_URL_PORT=
MAILER_DEFAULT_FROM=from@example.com

SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=

GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# Optional default/fallback Telegram bot for zine delivery. A reader can set
# their own bot token and chat id instead, in onboarding or preferences.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Let new users sign up
ENABLE_REGISTRATION=false
