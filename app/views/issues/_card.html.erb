<%= link_to issue_path(issue), class: "border border-border rounded-lg overflow-hidden flex flex-col hover:border-foreground/30 transition-colors cursor-pointer" do %>
  <div class="bg-muted aspect-[3/4] overflow-hidden" style="position: relative;">
    <%= CoverArt.new(issue.id).to_svg.html_safe %>

    <div style="position:absolute; inset:0; display:flex; flex-direction:column; justify-content:space-between; padding:18px; color:#000;">
      <div>
        <p class="text-5xl vt"><%= issue.title.upcase %></p>
        <p class="text-sm font-mono"><%= issue.published_at.strftime("%-d %B %Y") %></p>
      </div>

      <div class="flex items-end justify-between gap-3">
        <p class="text-4xl vt">#<%= issue.number %></p>
      </div>
    </div>
  </div>
<% end %>
