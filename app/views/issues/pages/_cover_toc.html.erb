<div class="sheet" data-logical-sheet>
  <div class="half">
    <span class="vt text-center mb-2">DOOMSCROLL.PRESS</span>
    <h1 class="text-6xl vt"><%= @issue.user.zine_preference&.zine_name&.upcase || "DOOMSCROLL" %></h1>
    <p class="font-mono text-xs">
      Issue #<%= @issue.number %> | 
      <%= @issue.published_at.strftime("%A %-d %B %Y") %>
    </p>

    <%= render "issues/pages/cover_artwork" %>

    <section>
      <div class="flex items-center gap-1 mb-2">
        <% @articles.pluck("url").each do |url| %>
           <%= feed_icon_url(url, size: 18, classes: "cover-in-this-issue__icon") %>
        <% end %>
      </div>
    </section>
  </div>

  <div class="half">
    <h2 class="vt text-3xl border-b pb-2 mb-4">In this issue</h2>

    <section class="flex flex-col gap-4">
      <% @articles.each_with_index do |article, i| %>
        <div class="flex items-start font-mono text-xs gap-2">
          <span class="text-muted-foreground"><%= i + 1 %>.</span>
          <div class="">
            <p class="mb-1"><%= article["title"] %></p>
            <span class="text-muted-foreground italic text-[8px]"><%= article["source"] %></span>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</div>
