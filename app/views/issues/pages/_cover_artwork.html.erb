<%
  palettes = [
    { bg: "#0a0a0a", stroke: "#84cc16" },
    { bg: "#0f1923", stroke: "#38bdf8" },
    { bg: "#1a0a2e", stroke: "#c084fc" },
    { bg: "#1a0a0a", stroke: "#fb7185" },
    { bg: "#0a1a0f", stroke: "#34d399" },
    { bg: "#1a1206", stroke: "#fbbf24" },
    { bg: "#1c1c1c", stroke: "#e5e5e5" },
    { bg: "#f5f0e8", stroke: "#1c1c1c" },
    { bg: "#e8f4f8", stroke: "#0369a1" },
    { bg: "#fef3c7", stroke: "#92400e" },
  ]

  rng     = Random.new(@issue.id)
  p       = palettes[rng.rand(palettes.size)]
  type    = rng.rand(8)
  sw      = (rng.rand(3) * 0.4 + 0.6).round(1)
  op      = (rng.rand(5) * 0.08 + 0.35).round(2)
  pid     = "p#{@issue.id}"
%>
<div class="cover-artwork">
  <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" style="display:block;">
    <rect width="100%" height="100%" fill="<%= p[:bg] %>"/>
    <defs>

      <% if type == 0 %>
        <%# Chevrons %>
        <pattern id="<%= pid %>" width="40" height="20" patternUnits="userSpaceOnUse">
          <polyline points="0,10 10,0 20,10 30,0 40,10" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
          <polyline points="0,20 10,10 20,20 30,10 40,20" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
        </pattern>

      <% elsif type == 1 %>
        <%# Waves %>
        <pattern id="<%= pid %>" width="40" height="20" patternUnits="userSpaceOnUse">
          <path d="M0,10 C8,2 16,2 20,10 C24,18 32,18 40,10" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
          <path d="M-20,10 C-12,2 -4,2 0,10 C4,18 12,18 20,10" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
        </pattern>

      <% elsif type == 2 %>
        <%# Diamonds %>
        <pattern id="<%= pid %>" width="24" height="24" patternUnits="userSpaceOnUse">
          <polygon points="12,0 24,12 12,24 0,12" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
        </pattern>

      <% elsif type == 3 %>
        <%# Dots %>
        <pattern id="<%= pid %>" width="18" height="18" patternUnits="userSpaceOnUse">
          <circle cx="9" cy="9" r="2.5" fill="<%= p[:stroke] %>" fill-opacity="<%= op %>"/>
        </pattern>

      <% elsif type == 4 %>
        <%# Hexagons (pointy-top, r=14) %>
        <pattern id="<%= pid %>" width="24.25" height="42" patternUnits="userSpaceOnUse">
          <polygon points="12.12,0 24.25,7 24.25,21 12.12,28 0,21 0,7" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
          <polygon points="0,21 12.12,28 12.12,42 0,49 -12.12,42 -12.12,28" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
          <polygon points="24.25,21 36.37,28 36.37,42 24.25,49 12.12,42 12.12,28" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
        </pattern>

      <% elsif type == 5 %>
        <%# Moroccan / 8-pointed star %>
        <pattern id="<%= pid %>" width="40" height="40" patternUnits="userSpaceOnUse">
          <polygon points="20,2 23.5,16.5 37,13 25.5,23 37,33 23.5,29.5 20,44 16.5,29.5 3,33 14.5,23 3,13 16.5,16.5" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
          <polygon points="0,2 3.5,16.5 17,13 5.5,23 17,33 3.5,29.5 0,44 -3.5,29.5 -17,33 -5.5,23 -17,13 -3.5,16.5" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
          <polygon points="40,2 43.5,16.5 57,13 45.5,23 57,33 43.5,29.5 40,44 36.5,29.5 23,33 34.5,23 23,13 36.5,16.5" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
        </pattern>

      <% elsif type == 6 %>
        <%# Cross / plus grid %>
        <pattern id="<%= pid %>" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M10,2 L10,18 M2,10 L18,10" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
        </pattern>

      <% else %>
        <%# Triangles %>
        <pattern id="<%= pid %>" width="30" height="26" patternUnits="userSpaceOnUse">
          <polygon points="15,0 30,26 0,26" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
          <polygon points="30,0 45,26 15,26" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
          <polygon points="0,0 15,26 -15,26" fill="none" stroke="<%= p[:stroke] %>" stroke-width="<%= sw %>" stroke-opacity="<%= op %>"/>
        </pattern>
      <% end %>

    </defs>
    <rect width="100%" height="100%" fill="url(#<%= pid %>)"/>
  </svg>
</div>
