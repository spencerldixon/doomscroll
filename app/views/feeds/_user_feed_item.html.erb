<div class="flex items-center justify-between p-3 border border-border rounded-lg">
  <div class="flex items-center gap-3">
    <%= feed_icon(feed, classes: "w-6 h-6 rounded object-contain") %>
    <div>
      <div class="flex items-center gap-2">
        <p class="text-sm font-semibold"><%= feed.name %></p>
        <%= feed_quality_indicator(feed) %>
      </div>
      <p class="text-xs text-muted-foreground"><%= feed.domain %></p>
    </div>
  </div>
  <%= button_to user_feed_path(feed.id), method: :delete, class: "btn-outline text-xs py-1 px-3" do %>
    Remove
  <% end %>
</div>
