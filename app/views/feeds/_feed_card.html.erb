<% path = subscribed ? user_feed_path(feed.id) : user_feeds_path %>
<% method = subscribed ? :delete : :post %>
<% button_params = subscribed ? { tab: "discover" } : { feed_id: feed.id, tab: "discover" } %>

<%= form_with url: path,
  method: method,
  data: {
    filter_target: "item",
    name: feed.name,
    description: feed.description
  },
  html: { id: "feed_#{feed.id}", style: "aspect-ratio: 3 / 4;" } do %>
  <% button_params.each do |name, value| %>
    <input type="hidden" name="<%= name %>" value="<%= value %>">
  <% end %>

  <button
    type="submit"
    data-selection-target="card"
    data-id="<%= feed.id %>"
    class="w-full flex flex-col items-center justify-center gap-2 py-6 px-3 border border-border rounded-lg cursor-pointer hover:border-violet-400 transition-all select-none <%= 'selected' if subscribed %>"
    style="height: 100%; overflow: hidden;"
    title="<%= subscribed ? "Unsubscribe from #{feed.name}" : "Subscribe to #{feed.name}" %>"
  >
    <%= feed_icon(feed, size: 64, classes: "w-10 h-10 rounded object-contain") %>

    <div class="w-full space-y-2 text-center overflow-hidden">
      <p class="text-xs font-semibold leading-tight" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"><%= feed.name %></p>
      <p class="text-[10px] text-muted-foreground leading-tight" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"><%= feed.description %></p>
    </div>
  </button>
<% end %>
