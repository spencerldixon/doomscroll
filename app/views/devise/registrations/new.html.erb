<div class="card">
  <header>
    <h2>Sign up</h2>
    <p>Create a new account
  </header>
  <section>
    <div class="form grid gap-6">
      <% if ENV["GOOGLE_OAUTH_CLIENT_ID"] && ENV["GOOGLE_OAUTH_CLIENT_SECRET"] %>
        <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false }, class: "btn-outline w-full flex items-center justify-center gap-2" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.9 6.1 29.7 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 16 19 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.9 6.1 29.7 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.6 0 10.6-2.1 14.4-5.6l-6.6-5.6C29.6 34.5 26.9 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.6 39.6 16.3 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.2 5.7l6.6 5.6c-.5.4 7.3-5.3 7.3-15.3 0-1.3-.1-2.4-.4-3.5z"/></svg>
          <span>Continue with Google</span>
        <% end %>

        <div class="flex items-center gap-2 text-muted-foreground text-xs">
          <span class="h-px flex-1 bg-border"></span>
          <span>OR</span>
          <span class="h-px flex-1 bg-border"></span>
        </div>
      <% end %>

      <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), class: "grid gap-6" do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="grid gap-2">
          <%= f.label :email %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
        </div>

        <div class="grid gap-2">
          <div class="flex justify-between items-center">
            <%= f.label :password %>
            <% if @minimum_password_length %>
              <em class="text-xs">(<%= @minimum_password_length %> characters minimum)</em>
            <% end %>
          </div>

          <%= f.password_field :password, autocomplete: "new-password" %>
        </div>

        <div class="grid gap-2">
          <%= f.label :password_confirmation %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
        </div>

        <div class="gap-2 flex flex-row items-start justify-between rounded-lg border p-4 shadow-xs">
          <div class="flex flex-col gap-0.5">
            <label for="tac-switch" class="leading-normal">Terms and conditions</label>
            <p class="text-muted-foreground text-sm">
            I have read and agree to the <%= link_to "terms of use", "https://getvigil.co.uk/terms", class: "underline" %> and <%= link_to "privacy policy", "https://getvigil.co.uk/privacy", class: "underline" %>
            </p>
          </div>
          <%= f.check_box :terms_and_conditions, id: "tac-switch", role: "switch" %>
        </div>

        <%= f.submit "Sign up", class: "btn" %>
      <% end %>

      <div class="text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </section>
</div>
