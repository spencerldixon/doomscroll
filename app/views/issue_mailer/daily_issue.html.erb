<div style="margin:0; padding:0; background:#fafafa; color:#0a0a0a; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <div style="max-width:640px; margin:0 auto; padding:32px 16px;">
    <div style="background:#ffffff; border:1px solid #e5e5e5; border-radius:8px; overflow:hidden;">
      <div style=" padding:18px 24px; text-align:center;">
        <div style="margin:0; color:#000; font-family:'VT323', 'Courier New', monospace; font-size:24px; line-height:1; letter-spacing:0;">
          doomscroll.press
        </div>
      </div>

      <div style="padding:22px 24px; border-bottom:1px solid #e5e5e5;">
        <h1 style="margin:0; color:#0a0a0a; font-size:30px; line-height:1.12; font-weight:650; letter-spacing:0;">
          Your new issue is ready to print!
        </h1>

        <p style="margin:14px 0 0; color:#404040; font-size:16px; line-height:1.6;">
          <strong><%= @issue.title %></strong> is waiting to help you beat the scroll. Print it, staple it, and read the good bits away from the screen.
        </p>
      </div>

      <div style="padding:22px 24px; border-bottom:1px solid #e5e5e5; background:#fafafa;">
        <div style="max-width:260px; margin:0 auto; background:#ffffff; border:1px solid #d4d4d4; border-radius:8px; overflow:hidden;">
          <div style="padding:16px 16px 10px; text-align:center;">
            <div style="margin:0; color:#0a0a0a; font-size:28px; line-height:1; font-weight:700;">
              <%= @issue.title.upcase %>
            </div>
            <div style="margin-top:8px; color:#737373; font-size:11px; line-height:1.4;">
              Issue #<%= @issue.number %> / <%= @issue.published_at.strftime("%-d %B %Y") %>
            </div>
          </div>

          <div style="height:300px; border-top:1px solid #eeeeee; border-bottom:1px solid #eeeeee; overflow:hidden;">
            <%= @cover_art_svg.html_safe %>
          </div>
        </div>

        <div style="margin-top:18px; text-align:center;">
          <%= link_to "Print your issue", @issue_url, style: "display:inline-block; background:#0a0a0a; color:#ffffff; padding:12px 18px; border-radius:6px; font-size:14px; line-height:1.2; font-weight:600; text-decoration:none;" %>
        </div>
      </div>

      <% if @featured_articles.any? %>
        <div style="padding:22px 24px; border-bottom:1px solid #e5e5e5;">
          <h2 style="margin:0 0 12px; color:#0a0a0a; font-size:18px; line-height:1.25; font-weight:650;">
            A few pieces waiting inside
          </h2>

          <% if @featured_authors.any? %>
            <p style="margin:0 0 14px; color:#525252; font-size:14px; line-height:1.5;">
              Featuring <%= @featured_authors.to_sentence %>.
            </p>
          <% end %>

          <% @featured_articles.each do |article| %>
            <div style="padding:14px 0; border-top:1px solid #eeeeee;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                <tr>
                  <td style="width:28px; vertical-align:top; padding:2px 12px 0 0;">
                    <% if article["icon_url"].present? %>
                      <%= image_tag article["icon_url"], alt: "", width: 20, height: 20, style: "display:block; width:20px; height:20px; border-radius:4px;" %>
                    <% else %>
                      <div style="width:20px; height:20px; border-radius:4px; background:#e5e5e5;"></div>
                    <% end %>
                  </td>
                  <td style="vertical-align:top;">
                    <p style="margin:0; color:#0a0a0a; font-size:15px; line-height:1.45; font-weight:600;">
                      <%= article["title"] %>
                    </p>
                    <p style="margin:5px 0 0; color:#737373; font-size:13px; line-height:1.4;">
                      <%= [article["source"], article["author"].presence && "by #{article['author']}"].compact.join(" ") %>
                    </p>
                  </td>
                </tr>
              </table>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @articles.any? %>
        <div style="padding:20px 24px; border-bottom:1px solid #e5e5e5; background:#fafafa;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:separate; border-spacing:0 8px;">
            <tr>
              <td style="width:50%; padding:0 4px 0 0;">
                <div style="background:#ffffff; border:1px solid #e5e5e5; border-radius:8px; padding:14px;">
                  <div style="color:#737373; font-size:12px; line-height:1.3;">Articles</div>
                  <div style="margin-top:4px; color:#0a0a0a; font-size:22px; line-height:1; font-weight:650;"><%= @articles.size %></div>
                </div>
              </td>
              <td style="width:50%; padding:0 0 0 4px;">
                <div style="background:#ffffff; border:1px solid #e5e5e5; border-radius:8px; padding:14px;">
                  <div style="color:#737373; font-size:12px; line-height:1.3;">Reading time</div>
                  <div style="margin-top:4px; color:#0a0a0a; font-size:22px; line-height:1; font-weight:650;"><%= @stats.reading_minutes %> min</div>
                </div>
              </td>
            </tr>
            <tr>
              <td style="width:50%; padding:0 4px 0 0;">
                <div style="background:#ffffff; border:1px solid #e5e5e5; border-radius:8px; padding:14px;">
                  <div style="color:#737373; font-size:12px; line-height:1.3;">Sources</div>
                  <div style="margin-top:4px; color:#0a0a0a; font-size:22px; line-height:1; font-weight:650;"><%= @stats.source_count %></div>
                </div>
              </td>
              <td style="width:50%; padding:0 0 0 4px;">
                <div style="background:#ffffff; border:1px solid #e5e5e5; border-radius:8px; padding:14px;">
                  <div style="color:#737373; font-size:12px; line-height:1.3;">Scroll avoided</div>
                  <div style="margin-top:4px; color:#0a0a0a; font-size:22px; line-height:1; font-weight:650;"><%= @stats.scroll_meters %> m</div>
                </div>
              </td>
            </tr>
          </table>
        </div>
      <% end %>

      <div style="padding:22px 24px;">
        <div style="background:#f5f5f5; border:1px solid #e5e5e5; border-radius:8px; padding:16px;">
          <h2 style="margin:0 0 10px; color:#0a0a0a; font-size:16px; line-height:1.3; font-weight:650;">
            Print instructions
          </h2>

          <ol style="margin:0; padding-left:20px; color:#404040; font-size:14px; line-height:1.65;">
            <li>Open the issue and press the <strong>Print</strong> button.</li>
            <li>Set your printer to <strong>double-sided</strong> printing and set <strong>flip on short edge</strong>.</li>
            <li>Fold the stack in half and staple the spine.</li>
            <li>Take it somewhere quiet and enjoy.</li>
          </ol>
        </div>

        <p style="margin:18px 0 0; color:#737373; font-size:12px; line-height:1.5;">
          If the button does not work, copy this link into your browser:<br>
          <span style="word-break:break-all;"><%= @issue_url %></span>
        </p>
      </div>
    </div>
  </div>
</div>
