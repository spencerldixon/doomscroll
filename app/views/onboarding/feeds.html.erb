<% content_for :body do %>
<body class="min-h-screen bg-background flex flex-col">
  <%= render "shared/flash" %>

  <div class="flex flex-col items-center justify-center flex-1 px-4 py-16">
    <div class="w-full max-w-5xl space-y-8">

      <%= render "onboarding/progress", step: 2 %>

      <div class="space-y-2">
        <h1 class="text-3xl font-semibold">Pick your feeds</h1>
        <p class="text-muted-foreground">Pick some feeds for your zine. You can change these or add your own at any time</p>
      </div>

      <%= form_with url: wizard_path, method: :put do |f| %>
        <div data-controller="filter">
          <div class="flex flex-wrap gap-2 mb-6" role="group" aria-label="Feed categories">
            <button type="button" class="btn-sm-primary rounded-full" data-filter-target="tab" data-category="" data-action="filter#selectCategory" aria-pressed="true">All</button>
            <% @categories.each do |category| %>
              <button type="button" class="btn-sm-outline rounded-full" data-filter-target="tab" data-category="<%= category %>" data-action="filter#selectCategory" aria-pressed="false"><%= category.titleize %></button>
            <% end %>
          </div>

          <div
            data-controller="selection"
            data-selection-multiple-value="true"
            data-selection-name-value="feed_ids[]"
            class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3 mb-8 max-h-[360px] overflow-y-auto pr-1"
          >
            <% @feeds.each do |feed| %>
              <% subscribed = @user_feed_ids.include?(feed.id) %>
              <div
                data-selection-target="card"
                data-filter-target="item"
                data-category="<%= feed.category %>"
                data-id="<%= feed.id %>"
                data-action="click->selection#toggle"
                class="flex flex-col items-center gap-2 p-3 border border-border rounded-lg cursor-pointer hover:border-violet-400 transition-all select-none text-center <%= 'selected' if subscribed %>"
              >
              <% if subscribed %>
                <input type="hidden" name="feed_ids[]" value="<%= feed.id %>" data-selection-target="input">
              <% end %>
                <div class="h-12 shrink-0 flex items-center justify-center">
                  <%= feed_icon(feed, size: 64, classes: "w-10 h-10 rounded object-contain") %>
                </div>
                <div class="w-full flex-1 flex flex-col gap-0.5">
                  <p class="text-xs font-semibold leading-tight break-words"><%= feed.name %></p>
                  <p class="text-[10px] text-muted-foreground truncate"><%= feed.domain || URI.parse(feed.url).host %></p>
                  <p class="text-[10px] text-muted-foreground line-clamp-2 leading-tight mt-auto pt-1"><%= feed.description %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex justify-between">
          <%= link_to "← Back", wizard_path(:name), class: "btn-outline" %>
          <button type="submit" class="btn-primary">
            Next &rarr;
          </button>
        </div>
      <% end %>
    </div>
  </div>
</body>
<% end %>
