<div class="border border-border rounded-lg overflow-hidden flex flex-col hover:border-foreground/30 transition-colors">

  <%# Cover %>
  <div class="bg-muted aspect-[3/4] flex flex-col items-center justify-center p-6 gap-2">
    <p class="text-xs font-mono uppercase tracking-widest text-muted-foreground">issue</p>
    <p class="text-5xl font-bold" style="font-family: 'VT323', monospace;"><%= issue.number %></p>
    <p class="text-xs text-muted-foreground"><%= issue.published_at.strftime("%B %-d, %Y") %></p>
  </div>

  <%# Meta %>
  <div class="p-4 flex flex-col gap-3 flex-1">
    <div>
      <p class="font-semibold text-sm leading-snug"><%= issue.title.presence || "Issue ##{issue.number}" %></p>
      <p class="text-xs text-muted-foreground mt-0.5"><%= issue.feed_count %> sources</p>
    </div>

    <div class="flex gap-2 mt-auto">
      <%= link_to issue.pdf_url, class: "btn-outline flex-1 text-xs py-1.5 text-center rounded-md", download: true do %>
        Download
      <% end %>
      <%= link_to issue.pdf_url, class: "btn-ghost flex-1 text-xs py-1.5 text-center rounded-md", target: "_blank", rel: "noopener" do %>
        Print
      <% end %>
    </div>
  </div>

</div>
