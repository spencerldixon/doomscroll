<div class="space-y-8">

  <%# Header %>
  <div class="flex items-end justify-between border-b border-border pb-6">
    <div>
      <p class="text-xs font-mono uppercase tracking-widest text-muted-foreground mb-1">your zine</p>
      <h1 class="text-4xl font-bold tracking-tight"><%= current_user.zine_preference&.zine_name %></h1>
    </div>
    <p class="text-sm text-muted-foreground">
      Delivered every <span class="text-foreground font-medium"><%= current_user.next_issue_day %></span>
    </p>
  </div>

  <%# Issues %>
  <div class="space-y-4">
    <h2 class="text-xs font-mono uppercase tracking-widest text-muted-foreground">Issues</h2>

    <% if false # replace with @issues.any? when Issue model exists %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <%# @issues.each do |issue| %>
          <%# render "dashboard/issue_card", issue: issue %>
        <%# end %>
      </div>
    <% else %>
      <div class="border border-dashed border-border rounded-lg py-20 flex flex-col items-center justify-center gap-2 text-center">
        <p class="font-medium">No issues yet.</p>
        <p class="text-sm text-muted-foreground">
          Your first issue lands on
          <span class="text-foreground font-medium"><%= current_user.next_issue_date&.strftime("%A, %B %-d") %></span>.
        </p>
      </div>
    <% end %>
  </div>

</div>
