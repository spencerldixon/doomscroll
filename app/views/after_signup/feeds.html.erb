<% content_for :body do %>
<body class="min-h-screen bg-background flex flex-col">
  <%= render "shared/flash" %>

  <div class="flex flex-col items-center justify-center flex-1 px-4 py-16">
    <div class="w-full max-w-5xl space-y-8">

      <%= render "after_signup/progress", step: 2 %>

      <div class="space-y-2">
        <h1 class="text-3xl font-semibold">Pick your feeds</h1>
        <p class="text-muted-foreground">Pick some feeds for your zine. You can change these or add your own at any time</p>
      </div>

      <%= form_with url: wizard_path, method: :put do |f| %>
        <div
          data-controller="selection"
          data-selection-multiple-value="true"
          data-selection-name-value="feed_ids[]"
          class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-9 gap-3 mb-8"
        >
          <% @feeds.each do |feed| %>
            <% subscribed = @user_feed_ids.include?(feed.id) %>
            <div
              data-selection-target="card"
              data-id="<%= feed.id %>"
              data-action="click->selection#toggle"
              class="flex flex-col items-center gap-2 p-3 border border-border rounded-lg cursor-pointer hover:border-violet-400 transition-all select-none aspect-[3/4] <%= 'selected' if subscribed %>"
            >
            <% if subscribed %>
              <input type="hidden" name="feed_ids[]" value="<%= feed.id %>" data-selection-target="input">
            <% end %>
              <div class="flex-1 flex items-center justify-center w-full">
                <% if feed.icon_url.present? %>
                  <img src="<%= feed.icon_url %>" alt="<%= feed.name %>" class="w-10 h-10 rounded object-contain">
                <% else %>
                  <img
                    src="https://www.google.com/s2/favicons?domain=<%= feed.domain || URI.parse(feed.url).host %>&sz=64"
                    alt="<%= feed.name %>"
                    class="w-10 h-10 rounded object-contain"
                  >
                <% end %>
              </div>
              <div class="w-full space-y-0.5 text-center">
                <p class="text-xs font-semibold truncate leading-tight"><%= feed.name %></p>
                <p class="text-[10px] text-muted-foreground truncate"><%= feed.domain || URI.parse(feed.url).host %></p>
                <p class="text-[10px] text-muted-foreground line-clamp-2 leading-tight"><%= feed.description %></p>
              </div>
            </div>
          <% end %>
        </div>

        <div class="flex justify-between">
          <%= link_to "← Back", wizard_path(:name), class: "btn-outline" %>
          <button type="submit" class="btn-primary">
            Next &rarr;
          </button>
        </div>
      <% end %>
    </div>
  </div>
</body>
<% end %>
