<header class="mb-10">
  <div class="flex flex-col md:grid md:grid-cols-3 items-center bg-lime-400 p-4 gap-3 md:gap-0">
    <%= link_to authenticated_root_path, class: "text-3xl vt" do %>
      DOOMSCROLL.PRESS
    <% end %>

    <nav class="vt flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm md:text-base">
      <%= link_to issues_path do %>
        Issues
      <% end %>

      <%= link_to feeds_path do %>
        Feeds
      <% end %>

      <%= link_to preferences_path do %>
        Settings
      <% end %>

      <%= link_to edit_user_registration_path do %>
        My Account
      <% end %>

      <%= button_to destroy_user_session_path, method: :delete, class: "cursor-pointer" do %>
        Log out
      <% end %>
    </nav>

    <div class="hidden md:flex items-center justify-end gap-3">
      <div class="flex items-center gap-1.5 font-mono text-xs"
        data-controller="countdown"
        data-countdown-deadline-value="<%= current_user.next_issue_date %>"
        >
        <span class="">Your next issue in</span>
        <span class="flex items-center gap-1">
          <span data-countdown-target="days" class="tabular-nums">--</span><span class="">d</span>
          <span data-countdown-target="hours" class="tabular-nums">--</span><span class="">h</span>
          <span data-countdown-target="minutes" class="tabular-nums">--</span><span class="">m</span>
          <span data-countdown-target="seconds" class="tabular-nums">--</span><span class="">s</span>
        </span>
      </div>
    </div>
  </div>

</header>
