<% content_for :title, title %>

<div class="flex justify-center items-center mb-10 text-center">
  <div class="space-y-1">
    <h1 class="text-3xl font-semibold sm:text-4xl xl:text-5xl vt uppercase"><%= title %></h1>

    <% if local_assigns[:subtitle] %>
      <p class="text-muted-foreground text-[1.05rem] sm:text-base"><%= subtitle %></p>
    <% end %>
  </div>
</div>
